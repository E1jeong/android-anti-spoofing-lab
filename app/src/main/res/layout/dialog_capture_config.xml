<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="16dp"
        android:paddingRight="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/capture_mode_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_mode"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#34473E" />

        <RadioGroup
            android:id="@+id/capture_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:padding="6dp"
            android:background="@drawable/capture_option_panel"
            android:checkedButton="@id/mode_face">

            <RadioButton
                android:id="@+id/mode_face"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/capture_touch_height"
                android:textSize="16sp"
                android:text="@string/capture_mode_face" />

            <RadioButton
                android:id="@+id/mode_no_face"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/capture_touch_height"
                android:textSize="16sp"
                android:text="@string/capture_mode_no_face" />

            <RadioButton
                android:id="@+id/mode_attack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/capture_touch_height"
                android:textSize="16sp"
                android:text="@string/capture_mode_attack" />
        </RadioGroup>

        <TextView
            android:id="@+id/capture_mode_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textSize="16sp"
            android:textColor="#34473E" />

        <TextView
            android:id="@+id/class_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_class"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#34473E" />

        <FrameLayout
            android:id="@+id/class_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/capture_option_panel">

            <Spinner
                android:id="@+id/class_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/capture_touch_height" />
        </FrameLayout>

        <TextView
            android:id="@+id/scene_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_scene"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#34473E" />

        <FrameLayout
            android:id="@+id/scene_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/capture_option_panel">

            <Spinner
                android:id="@+id/scene_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/capture_touch_height" />
        </FrameLayout>

        <TextView
            android:id="@+id/environment_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_environment"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#34473E" />

        <RadioGroup
            android:id="@+id/environment_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:padding="6dp"
            android:background="@drawable/capture_option_panel"
            android:checkedButton="@id/indoor">

            <RadioButton
                android:id="@+id/indoor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/capture_touch_height"
                android:textSize="16sp"
                android:text="@string/capture_indoor" />

            <RadioButton
                android:id="@+id/outdoor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/capture_touch_height"
                android:textSize="16sp"
                android:text="@string/capture_outdoor" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/quality_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quality_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/capture_live_quality"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#34473E" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:padding="6dp"
                android:background="@drawable/capture_option_panel"
                android:checkedButton="@id/medium">

                <RadioButton
                    android:id="@+id/medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/capture_touch_height"
                    android:textSize="16sp"
                    android:text="@string/capture_medium" />

                <RadioButton
                    android:id="@+id/high"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/capture_touch_height"
                    android:textSize="16sp"
                    android:text="@string/capture_high" />

                <RadioButton
                    android:id="@+id/off"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/capture_touch_height"
                    android:textSize="16sp"
                    android:text="@string/capture_off" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
